{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Terminal Manager",
  "version": "0.1.0",
  "identifier": "dev.local.terminalmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Terminal Manager",
      "width": 1200,
      "height": 780,
      "minWidth": 760,
      "minHeight": 480,
      "backgroundColor": "#151719"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "targets": "all",
    "shortDescription": "Your terminals, together.",
    "category": "DeveloperTool"
  }
}
